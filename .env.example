# Copy to .env only to write synthetic material on a cloud model, or to compare a
# hosted model. Evidence chapters run fully offline on Ollama without any of these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenRouter: run a lesson on a hosted model to compare (make lesson N=NN PROVIDER=openrouter).
OPENROUTER_API_KEY=

# Optional overrides
# LANTERN_PROVIDER=ollama          # or openrouter
# LANTERN_MODEL=qwen3:4b
# OLLAMA_HOST=http://localhost:11434
